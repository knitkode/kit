{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/coverage", "!**/CHANGELOG.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              [":PACKAGE:", "!@knitkode/**"],
              "@knitkode/**",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "preset": "none"
      },
      "style": {
        "preset": "none"
      },
      "performance": {
        "preset": "none"
      },
      "nursery": {
        "preset": "none"
      },
      "a11y": {
        "preset": "none"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noDoubleEquals": "off",
        "noTsIgnore": "off",
        "noDocumentCookie": "off",
        "noPrototypeBuiltins": "off",
        "noConfusingVoidType": "off",
        "noImplicitAnyLet": "off",
        "noControlCharactersInRegex": "off",
        "useIterableCallbackReturn": "off",
        "noShadowRestrictedNames": "off",
        "noGlobalIsFinite": "off",
        "noGlobalIsNan": "off",
        "noArrayIndexKey": "off",
        "noThenProperty": "off",
        "noConstEnum": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    }
  ]
}
