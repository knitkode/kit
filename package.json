{
  "name": "@knitkode/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo watch build",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:build": "pnpm build && typedoc",
    "check:stable": "node tools/check-stable-major.mjs",
    "verify": "pnpm lint && pnpm check:stable && turbo run build typecheck test",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "codegen:type-fest": "tsx tools/type-fest-exports.ts",
    "clean": "rm -rf .turbo coverage packages/*/dist packages/*/coverage packages/*/.turbo"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.6.0",
    "pkg-pr-new": "^0.0.90",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
